<Page x:Class="PZ3_Bortsova.Pages.Autho"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:PZ3_Bortsova.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Autho" Background="White"
      Loaded="ALoaded">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Label Content="Авторизация" HorizontalAlignment="Center" FontWeight="Bold" FontSize="20" Margin="0,0,0,10"/>
            <Image Source="/Resources/3c40b0688e37286b278e32411accd53e.jpg" Width="92" Height="79" Margin="0,0,0,20"/>
            <TextBlock Text="Логин:"/>
            <TextBox x:Name="txtbLogin" Width="250"/>
            <TextBlock Text="Пароль:"/>
            <PasswordBox x:Name="pswbPassword" Width="250"/>
            <TextBlock x:Name="txtBlockCaptcha" Text="Капча:" Visibility="Hidden"/>
            <TextBox x:Name="txtboxCaptcha"  Visibility="Hidden" Width="250"/>
            <TextBox x:Name="txtboxCaptchaVvod" Visibility="Hidden" Width="250"/>

            <TextBlock HorizontalAlignment="Center" Visibility="Hidden" x:Name="txtBlockTimer"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="btnRegistr" Content="Зарегистрироваться" Click="btnRegistr_Click" FontSize="11" Margin="5"/>
                <Button x:Name="btnEnter" Content="Войти" Click="btnEnter_Click" Margin="5"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Page>